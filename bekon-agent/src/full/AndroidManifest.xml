<?xml version="1.0" encoding="utf-8"?>
<!-- Optional Bekon Keys IME: only in the "full" flavor. The playStore flavor omits it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sideload build only: the "Stop optimizing battery?" dialog. The Play build has no
         REQUEST_IGNORE_BATTERY_OPTIMIZATIONS; it only points to the battery settings screens. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <queries>
        <intent>
            <action android:name="android.settings.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
        </intent>
    </queries>
    <application>
        <service
            android:name=".device.ime.BekonImeService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/bekon_ime" />
        </service>
    </application>
</manifest>
